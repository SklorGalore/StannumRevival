stannum-case 0.1
# Written by hand: tables out of order, fields in any order, defaults
# written out, extra spaces and comments. The canonical form sorts all of
# it and leaves the defaults off.

line 1:2:1   x_pu=0.06 from=1 to=2   r_pu=0.01 status=on   # in service
bus 2 number=2 kv=138 type=pq name="Central 138"
bus 1 number=1 kv=138 type=ref vm_pu=1.04 name="North \"A\""

# Loads and generation.
generator 1:1 bus=1 p_mw=60.5 vset_pu=1.04
load 2:1 bus=2 p_mw=60 q_mvar=-0.0
